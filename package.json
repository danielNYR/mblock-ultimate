{
  "name": "mblock-ultimate",
  "author": "Moldhea",
  "version": "1.3.1",
  "private": true,
  "description": "Extensión de Firefox: bloqueo de anuncios, guardia de redirecciones y cookies fantasma.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "test": "node --test --test-force-exit tests/*.test.mjs",
    "coverage": "mkdir -p coverage && node --test --test-force-exit --experimental-test-coverage --test-coverage-include='extension/**/*.js' --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/*.test.mjs",
    "lint": "eslint . && npm run lint:ext",
    "lint:ext": "npx --yes web-ext@10.7.0 lint --source-dir extension --warnings-as-errors",
    "build": "npx --yes web-ext@10.7.0 build --source-dir extension --artifacts-dir dist --overwrite-dest",
    "start": "npx --yes web-ext@10.7.0 run --source-dir extension",
    "build-lists": "node scripts/build-lists.mjs",
    "check-lists": "node scripts/build-lists.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.13.0",
    "jsdom": "30.1.3"
  },
  "engines": {
    "node": ">=24"
  }
}
