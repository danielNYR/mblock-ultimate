{
  "name": "mblock-ultimate",
  "author": "Moldhea",
  "version": "1.3.0",
  "private": true,
  "description": "Extensión de Firefox: bloqueo de anuncios, guardia de redirecciones y cookies fantasma.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "lint": "npx --yes web-ext@10 lint --source-dir extension",
    "build": "npx --yes web-ext@10 build --source-dir extension --artifacts-dir dist --overwrite-dest",
    "start": "npx --yes web-ext@10 run --source-dir extension",
    "build-lists": "node scripts/build-lists.mjs",
    "check-lists": "node scripts/build-lists.mjs --check"
  }
}
